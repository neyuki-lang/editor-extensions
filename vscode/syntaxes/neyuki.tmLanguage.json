{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Neyuki",
  "scopeName": "source.neyuki",
  "fileTypes": ["nyk"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#builtins" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-dash.neyuki",
          "match": "(?:^|\\s)--.*$"
        },
        {
          "name": "comment.block.neyuki",
          "begin": "(?:^|\\s)--\\[\\[",
          "end": "\\]\\]",
          "patterns": [
            { "include": "#comments" }
          ]
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.neyuki",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.neyuki",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.neyuki",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.neyuki",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.multiline.neyuki",
          "begin": "\\[\\[",
          "end": "\\]\\]"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.bigint.neyuki",
          "match": "\\b\\d[\\d_]*n\\b"
        },
        {
          "name": "constant.numeric.hex.neyuki",
          "match": "\\b0[xX][0-9A-Fa-f_]+\\b"
        },
        {
          "name": "constant.numeric.binary.neyuki",
          "match": "\\b0[bB][01_]+\\b"
        },
        {
          "name": "constant.numeric.octal.neyuki",
          "match": "\\b0[oO][0-7_]+\\b"
        },
        {
          "name": "constant.numeric.float.neyuki",
          "match": "(?:\\d[\\d_]*\\.\\d[\\d_]*|\\d[\\d_]*\\.?\\d[\\d_]*[eE][+-]?\\d[\\d_]*|\\.\\d[\\d_]*)(?:[fF])?"
        },
        {
          "name": "constant.numeric.integer.neyuki",
          "match": "\\b\\d[\\d_]*\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.neyuki",
          "match": "\\b(?:and|break|const|continue|do|else|elseif|end|false|for|function|global|if|in|local|nil|not|or|repeat|return|then|true|type|until|while)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.neyuki",
          "match": "\\b(?:assert|bigint|float|int|print|require|tostring|tonumber|try|typeof|type)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.neyuki",
          "match": "[=\\+\\-\\*/%<>!~^|:&]+|::"
        }
      ]
    }
  }
}