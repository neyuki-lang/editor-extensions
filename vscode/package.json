{
  "name": "neyuki",
  "displayName": "Neyuki",
  "description": "Highlighting, completion, hover, diagnostics, navigation, rename, formatting, running and debugging for the Neyuki language, powered by the language server in the neyuki executable.",
  "version": "0.3.0",
  "publisher": "neyuki",
  "license": "MIT",
  "main": "./src/extension.js",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers",
    "Linters",
    "Formatters",
    "Snippets"
  ],
  "keywords": [
    "neyuki",
    "nyk",
    "lua",
    "scripting"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/neyuki-lang/editor-extensions.git"
  },
  "homepage": "https://neyuki.cc",
  "bugs": {
    "url": "https://github.com/neyuki-lang/editor-extensions/issues"
  },
  "activationEvents": [
    "onDebugResolve:neyuki",
    "onDebugDynamicConfigurations:neyuki"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "package": "npx @vscode/vsce package"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.3.2"
  },
  "contributes": {
    "languages": [
      {
        "id": "neyuki",
        "aliases": ["Neyuki", "neyuki"],
        "extensions": [".nyk"],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./file-icon.svg",
          "dark": "./file-icon.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "neyuki",
        "scopeName": "source.neyuki",
        "path": "./syntaxes/neyuki.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.expression.neyuki": "neyuki"
        }
      }
    ],
    "snippets": [
      {
        "language": "neyuki",
        "path": "./snippets/neyuki.json"
      }
    ],
    "configuration": {
      "title": "Neyuki",
      "properties": {
        "neyuki.path": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "Path to the `neyuki` executable. Leave empty to use `neyuki` from the `PATH`."
        },
        "neyuki.lint.enable": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show the errors and warnings the Neyuki language server reports. The server decides when to check. Changing this restarts the server."
        },
        "neyuki.completion.insertParentheses": {
          "type": "boolean",
          "default": true,
          "description": "Add parentheses when completing a function."
        }
      }
    },
    "commands": [
      {
        "command": "neyuki.restartServer",
        "title": "Restart Language Server",
        "category": "Neyuki"
      },
      {
        "command": "neyuki.stopServer",
        "title": "Stop Language Server",
        "category": "Neyuki"
      },
      {
        "command": "neyuki.showServerOutput",
        "title": "Show Language Server Output",
        "category": "Neyuki"
      },
      {
        "command": "neyuki.runFile",
        "title": "Run File",
        "category": "Neyuki",
        "icon": "$(play)"
      },
      {
        "command": "neyuki.debugFile",
        "title": "Debug File",
        "category": "Neyuki",
        "icon": "$(debug-alt)"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "neyuki.runFile",
          "when": "resourceLangId == neyuki",
          "group": "navigation@0"
        },
        {
          "command": "neyuki.debugFile",
          "when": "resourceLangId == neyuki",
          "group": "navigation@1"
        }
      ],
      "explorer/context": [
        {
          "command": "neyuki.runFile",
          "when": "resourceLangId == neyuki",
          "group": "navigation@9"
        }
      ],
      "commandPalette": [
        {
          "command": "neyuki.runFile",
          "when": "editorLangId == neyuki"
        },
        {
          "command": "neyuki.debugFile",
          "when": "editorLangId == neyuki"
        }
      ]
    },
    "keybindings": [
      {
        "command": "neyuki.runFile",
        "key": "ctrl+f5",
        "mac": "cmd+f5",
        "when": "editorLangId == neyuki && !inDebugMode"
      }
    ],
    "breakpoints": [
      {
        "language": "neyuki"
      }
    ],
    "debuggers": [
      {
        "type": "neyuki",
        "label": "Neyuki",
        "languages": ["neyuki"],
        "configurationAttributes": {
          "launch": {
            "required": ["program"],
            "properties": {
              "program": {
                "type": "string",
                "description": "The Neyuki file to run.",
                "default": "${file}"
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Pause on the first line.",
                "default": false
              },
              "cwd": {
                "type": "string",
                "description": "Directory to run in. Defaults to the workspace folder.",
                "default": "${workspaceFolder}"
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "neyuki",
            "request": "launch",
            "name": "Debug current file",
            "program": "${file}"
          }
        ],
        "configurationSnippets": [
          {
            "label": "Neyuki: Debug a file",
            "description": "Run a Neyuki script under the debugger",
            "body": {
              "type": "neyuki",
              "request": "launch",
              "name": "Debug ${1:file}",
              "program": "^\"\\${workspaceFolder}/${1:main.nyk}\""
            }
          }
        ]
      }
    ],
    "taskDefinitions": [
      {
        "type": "neyuki",
        "required": ["file"],
        "properties": {
          "file": {
            "type": "string",
            "description": "The Neyuki file to run."
          }
        }
      }
    ]
  }
}
