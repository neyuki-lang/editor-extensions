{
  "name": "neyuki",
  "displayName": "Neyuki",
  "description": "Syntax highlighting and editor support for the Neyuki language.",
  "version": "0.1.0",
  "publisher": "neyuki",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "neyuki",
    "language",
    "syntax",
    "nyk"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/neyuki/neyuki-lang.git"
  },
  "bugs": {
    "url": "https://github.com/neyuki/neyuki-lang/issues"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.0",
    "vscode-languageserver": "^9.0.0",
    "vscode-languageserver-textdocument": "^1.0.0"
  },
  "contributes": {
    "languages": [{
      "id": "neyuki",
      "aliases": ["Neyuki", "neyuki"],
      "extensions": [".nyk"],
      "configuration": "./language-configuration.json",
      "icon": {
        "light": "./file-icon.svg",
        "dark": "./file-icon.svg"
      }
    }],
    "grammars": [{
      "language": "neyuki",
      "scopeName": "source.neyuki",
      "path": "./syntaxes/neyuki.tmLanguage.json"
    }]
  }
}
